FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install ALL dependencies (including devDependencies for build)
RUN npm ci

# Copy source code
COPY . .

# Build argument for API URL (Railway will inject this)
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

# Debug: Show environment variables
RUN echo "🔧 Build-time VITE_API_URL: $VITE_API_URL"

# Build the application using npx
RUN npx vite build

# Install a simple HTTP server to serve static files
RUN npm install -g serve

# Clean up dev dependencies to reduce image size (but keep serve)
RUN npm prune --production

# Expose port (Railway will override with $PORT)
EXPOSE 3000

# Serve the built application using serve instead of vite preview
CMD ["serve", "-s", "dist", "-l", "3000"]

