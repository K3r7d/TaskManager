FROM python:3.12.0-slim

# Set working directory
WORKDIR /code

# Install dependencies
COPY requirements.txt .
RUN pip install --upgrade pip
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend code
COPY ./app ./app

COPY ./test ./test

# Set PYTHONPATH so 'app' is discoverable
ENV PYTHONPATH=/code

EXPOSE 8000

# Set default PORT if not provided (for local development)
ENV PORT=8000

# Run FastAPI - PORT will be provided by cloud platforms, defaults to 8000 locally
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port $PORT --reload"]