FROM python:3.12.0-slim

# Set working directory
WORKDIR /code

# Install dependencies
COPY requirements.txt .
RUN pip install --upgrade pip
RUN pip install --no-cache-dir -r requirements.txt
# Install additional test reporting dependencies
RUN pip install pytest-html pytest-json-report

# Copy backend code and tests
COPY ./app ./app
COPY ./test ./test
COPY ./pytest.ini ./pytest.ini

# Set PYTHONPATH so 'app' is discoverable
ENV PYTHONPATH=/code

# Default command to run tests with reporting
CMD ["python", "-m", "pytest", "test/", "-v", "--tb=short", "--junitxml=/tmp/test-results.xml", "--html=/tmp/test-report.html", "--json-report", "--json-report-file=/tmp/test-report.json"]
